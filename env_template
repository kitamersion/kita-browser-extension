# for local development set APPLICATION_ENVIRONMENT=dev.

APPLICATION_ENVIRONMENT=prod

# For local development - paste your AniList access token here

# You can get this from AniList GraphQL playground or by doing OAuth once

ANILIST_ACCESS_TOKEN=

# Supabase project (cross-device sync) - paste your project's URL and anon public key
# SUPABASE_URL is the bare project URL, e.g. https://<ref>.supabase.co (no /rest/v1 or other path suffix)
SUPABASE_URL=
SUPABASE_ANON_KEY=
